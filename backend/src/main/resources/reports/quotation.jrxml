<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="quotation"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="15"
    bottomMargin="15"
    whenNoDataType="AllSectionsNoDetail">

    <!-- ===================== PARAMETERS ===================== -->

    <parameter name="quotationNo" class="java.lang.String"/>
    <parameter name="quotationDate" class="java.lang.String"/>
    <parameter name="clientName" class="java.lang.String"/>
    <parameter name="clientDesignation" class="java.lang.String"/>
    <parameter name="clientAddressLine1" class="java.lang.String"/>
    <parameter name="clientAddressLine2" class="java.lang.String"/>

    <parameter name="toAndFroCharges" class="java.lang.String"/>

    <parameter name="introText" class="java.lang.String">
        <defaultValueExpression><![CDATA[
            "As per our discussion regarding Erection and commissioning work of all spinning machines,Luwa plant we are giving our lowest offer as follow:"
        ]]></defaultValueExpression>
    </parameter>

    <parameter name="bankAccountHolderName" class="java.lang.String"/>
    <parameter name="bankAccountNo" class="java.lang.String"/>
    <parameter name="bankName" class="java.lang.String"/>
    <parameter name="bankBranch" class="java.lang.String"/>
    <parameter name="bankIfscCode" class="java.lang.String"/>
    <parameter name="companyName" class="java.lang.String"/>
    
    <!-- ===================== DATA FIELDS ===================== -->
    <!-- IMPORTANT:
         QuotationItem.rate is BigDecimal, therefore the JRXML field must also be BigDecimal.
         Do NOT use rateText unless QuotationItem actually has getRateText(). -->
    <field name="description" class="java.lang.String"/>
    <field name="rate" class="java.math.BigDecimal"/>

   
    <title>
        <band height="112">
            <!-- Date -->
            <textField isBlankWhenNull="true">
                <reportElement x="390" y="92" width="155" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $P{quotationDate} == null ? "" : "Date: " + $P{quotationDate}
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ===================== CLIENT / INTRO ===================== -->
    <pageHeader>
        <band height="91">

            <staticText>
                <reportElement x="0" y="0" width="555" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[To,]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="15" y="13" width="525" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{clientDesignation}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="15" y="27" width="525" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{clientName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="15" y="41" width="525" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{clientAddressLine1}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="15" y="55" width="525" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{clientAddressLine2}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="69" width="555" height="14"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Respected Sir,]]></text>
            </staticText>

        </band>
    </pageHeader>

    <!-- Intro is kept just above the table -->
    <columnHeader>
        <band height="50">

            <textField isBlankWhenNull="true">
                <reportElement x="30" y="0" width="525" height="28"/>
                <textElement textAlignment="Justified" verticalAlignment="Top">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{introText}]]></textFieldExpression>
            </textField>

            <!-- Table header -->
            <staticText>
                <reportElement x="30" y="28" width="65" height="22"/>
                <box>
                    <pen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Sr.No]]></text>
            </staticText>

            <staticText>
                <reportElement x="95" y="28" width="230" height="22"/>
                <box>
                    <pen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>

            <staticText>
                <reportElement x="325" y="28" width="230" height="22"/>
                <box>
                    <pen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Rate]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ===================== DETAIL TABLE ===================== -->
    <detail>
        <band height="23">

            <textField>
                <reportElement x="30" y="0" width="65" height="23"/>
                <box>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="95" y="0" width="230" height="23"/>
                <box>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>

            <!-- rate is BigDecimal -->
            <textField>
                <reportElement x="325" y="0" width="230" height="23"/>
                <box>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[
                    "Rs." +
                    java.text.NumberFormat.getNumberInstance(new java.util.Locale("en","IN")).format($F{rate}) +
                    "/-" +
                    (
                        "Blow Room".equals($F{description}) ? " per Line." :
                        "Carding".equals($F{description}) ? " per card." :
                        "Br. Draw Frame".equals($F{description}) ? " per machine." :
                        "Fin. Draw Frame".equals($F{description}) ? " per machine." :
                        "Speed Frame (with OHTC)".equals($F{description}) ? " per machine." :
                        "Ring Frame (with OHTC)".equals($F{description}) ? " per spindle." :
                        "Link Coner (with OHTC)".equals($F{description}) ? " per machine." :
                        "All LUWA Plant".equals($F{description}) ? " per Spindle." :
                        "BTS".equals($F{description}) ? "" : ""
                    )
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ===================== TERMS + BANK DETAILS ===================== -->
    <summary>
        <band height="310">

            <staticText>
                <reportElement x="0" y="8" width="555" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Terms & Condition :]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="27" width="535" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "1)" +
                    ($P{toAndFroCharges} == null ? "" : $P{toAndFroCharges}) 
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="20" y="42" width="535" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[2) Lodging arrangement of our technicians you have to provide in mill campus.]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="57" width="535" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[3) Boarding (Snacks, Tea, Lunch & Dinner) in your scope.]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="72" width="535" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[4) Tools and guages,pallates and forklift you have to provide.]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="87" width="535" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[5) Electrical work in your scope.]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="102" width="300" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[6) Taxes : TDS 1%]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="117" width="300" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[GST Not Applicable.]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="137" width="30" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[7)]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="137" width="495" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Payment : 1) 20% Advance payment along with work order before starting work.]]></text>
            </staticText>

            <staticText>
                <reportElement x="65" y="152" width="450" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[2) 40% payment after 1st month after starting month.]]></text>
            </staticText>

            <staticText>
                <reportElement x="65" y="167" width="450" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[3) 30% payment after 2nd month after starting month.]]></text>
            </staticText>

            <staticText>
                <reportElement x="65" y="182" width="450" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[4) 10% payment after commissioning of all machines.]]></text>
            </staticText>

            <!-- Bank details -->
            <staticText>
                <reportElement x="0" y="204" width="200" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Bank Details : -]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="220" width="400" height="13"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Name - " + ($P{bankAccountHolderName} == null ? "" : $P{bankAccountHolderName})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="233" width="400" height="13"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Account No - " + ($P{bankAccountNo} == null ? "" : $P{bankAccountNo})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="246" width="400" height="13"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Bank - " + ($P{bankName} == null ? "" : $P{bankName})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="259" width="400" height="13"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Branch - " + ($P{bankBranch} == null ? "" : $P{bankBranch})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="20" y="272" width="400" height="13"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["IFSC code - " + ($P{bankIfscCode} == null ? "" : $P{bankIfscCode})]]></textFieldExpression>
            </textField>

           <textField isBlankWhenNull="true">
                <reportElement x="380" y="286" width="175" height="16"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                  <textFieldExpression><![CDATA["For " + ($P{companyName} == null ? "" : $P{companyName})]]></textFieldExpression>
           </textField>

        </band>
    </summary>

</jasperReport>
